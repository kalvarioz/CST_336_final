<%- include("partials/header") %>

<main class="container mt-4">
    <% if (user) { %>
        <h1>Welcome, <%= user.displayName %>!</h1>
        <p class="text-muted">Your music library is ready. Streaming proxy is active.</p>

        <!-- Quick test player -->
        <section class="mt-4">
            <h5>Quick Stream Test</h5>
            <p class="text-muted small">
                If you hear audio below, the full pipeline is working:
                Login &rarr; Session &rarr; Express Proxy &rarr; R2 &rarr; Browser.
            </p>
            <audio id="testPlayer" controls class="w-100 mt-2">
                <source src="/api/songs/stream/1" type="audio/flac">
                Your browser does not support the audio element.
            </audio>
        </section>
    <% } else { %>
        <div class="text-center mt-5">
            <i class="bi bi-music-note-beamed display-1 text-primary"></i>
            <h1 class="mt-3">SoundVault</h1>
            <p class="lead text-muted">A secure, personal music player in your browser.</p>
            <div class="mt-4">
                <a href="/login" class="btn btn-primary btn-lg me-2">Log In</a>
                <a href="/signup" class="btn btn-outline-secondary btn-lg">Sign Up</a>
            </div>
        </div>
    <% } %>
</main>

<%- include("partials/footer") %>
