<%- include("partials/header") %>

<body>
    <h1>Creating a New Playlist</h1>
    <div class="mb-3">
        <form action ="/api/playlist" method ="POST" >
            <label>Playlist Name:</label>
            <br>
            <input type="text" name="name" required>
            <br>
            <label>Playlist Description:</label>
            <br>
            <textarea name="description"></textarea>
            <br>
            <button type = "submit" class="btn btn-outline-dark me-3 btn-sm">Create</button>
        </form>
    </div>
    <a href="/playlists" class="btn btn-outline-dark me-3 btn-sm">Back to Playlists</a>
</body>
</html>