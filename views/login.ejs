<%- include("partials/header") %>
<!-- Brandon Calvario -->

<main class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="text-center mb-4">
                <i class="bi bi-music-note-beamed display-3 text-primary"></i>
                <h2 class="mt-2">Welcome Back</h2>
                <p class="text-muted">Log in to access your music</p>
            </div>
            <!-- Server-side error display (rendered by EJS) -->
            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger" role="alert">
                    <% errors.forEach(err => { %>
                        <div><%= err %></div>
                    <% }); %>
                </div>
            <% } %>
            <!-- Login Form submits directly to the server -->
            <!-- Rubric: text input + password = 2 of 3+ required form types -->
            <form action="/api/auth/login" method="POST" id="loginForm">
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input
                        type="text"
                        class="form-control"
                        id="username"
                        name="username"
                        placeholder="Enter your username"
                        required
                        autocomplete="username"
                    >
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        required
                        autocomplete="current-password"
                    >
                </div>

                <button type="submit" class="btn btn-primary w-100" id="loginBtn">
                    Log In
                </button>
            </form>

            <p class="text-center mt-3">
                Don&rsquo;t have an account?
                <a href="/signup">Sign up here</a>
            </p>

        </div>
    </div>
</main>

<!-- Client-side validation (enhancement form still works without JS) -->
<script src="/js/auth.js"></script>

<%- include("partials/footer") %>
