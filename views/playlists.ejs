<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Playlists</title>
</head>
<body>
    <h1>Your Playlists</h1>
    <ul>
        <% if (playlists.length == 0) {%>
            <p>You have no playlists</p>
        <%} else { %>
            <% for (i of playlists) { %>
                <li>
                    <a href="/playlist/<%=i.playlist_id%>"><%=i.name%></a>
                </li>
            <% } %>
        <% } %>
    </ul>
    <a href="/newPlaylist" class="btn btn-outline-light me-3 btn-sm">Create a new Playlist</a>
    <br>
    <a href="/index">Home</a>
</body>
</html>